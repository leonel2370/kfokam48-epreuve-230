# Copier ce fichier : cp .env.example .env   puis renseigner les valeurs.
# .env contient les informations sensibles : il est ignoré par Git et ne doit JAMAIS être commité.

# --- Outillage GitHub (scripts locaux uniquement ; la CI utilise les secrets GitHub) ---
# Jeton personnel « fine-grained » : droits Issues + Pull requests + Contents sur le dépôt
GH_TOKEN=
GH_REPO=leonel2370/kfokam48-epreuve-230

# --- Qualité : SonarQube Server de l'équipe (My Account > Security > Generate token, type « User ») ---
SONAR_HOST_URL=http://10.0.102.40:9000
SONAR_TOKEN=
SONAR_PROJECT_KEY=kfokam48-epreuve-230

# --- Base de données (valeurs de démonstration locales ; à changer hors démo) ---
POSTGRES_DB=presence48
POSTGRES_USER=presence48
POSTGRES_PASSWORD=change-me

# --- Backend Spring Boot ---
# Noms volontairement hors du préfixe SPRING_ : Spring ne les lie pas tout seul, ils ne peuvent donc pas
# écraser le profil de test (bug #51). Seul application.yml les lit.
DB_URL=jdbc:postgresql://localhost:5432/presence48
DB_USERNAME=presence48
DB_PASSWORD=change-me
BACKEND_PORT=8080

# --- Frontend Angular ---
# Pièces jointes d'exercice (v2, RG30) : dossier hors du répertoire web ; volume Docker en conteneur
UPLOAD_DIR=./uploads
FRONTEND_PORT=4200
API_URL=http://localhost:8080/api
